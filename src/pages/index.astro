---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projects } from '../data/projects';
import { copy } from '../data/copy';
---
<BaseLayout>
  <section class="hero wrap">
    <h1 class="hero-statement">
      <span data-edit="home.headline.open">{copy('home.headline.open', 'I turn')}</span>
      <span class="complexity-word" data-text={copy('home.headline.complexity', 'complexity')} data-edit="home.headline.complexity">{copy('home.headline.complexity', 'complexity')}</span>
      <span class="clarity-line"><span data-edit="home.headline.close">{copy('home.headline.close', 'into')}</span> <em data-edit="home.headline.clarity">{copy('home.headline.clarity', 'clarity')}</em><b aria-hidden="true">.</b></span>
    </h1>
    <div class="hero-bottom">
      <p data-edit="home.intro">{copy('home.intro', 'Product design leader connecting customer insight, business strategy, and teams that know how to move.')}</p>
      <div class="hero-proof" aria-label="Experience and areas of focus">
        <p><strong data-edit="home.proof.1.value">{copy('home.proof.1.value', '13+')}</strong><span data-edit="home.proof.1.label">{copy('home.proof.1.label', 'years designing products')}</span></p>
        <p><strong data-edit="home.proof.2.value">{copy('home.proof.2.value', '4+')}</strong><span data-edit="home.proof.2.label">{copy('home.proof.2.label', 'years leading teams')}</span></p>
        <p><strong data-edit="home.proof.3.value">{copy('home.proof.3.value', 'SaaS / AI / Commerce')}</strong></p>
      </div>
      <a href="#work" class="down-link">Selected work <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section id="work" class="work wrap section-pad">
    <div class="section-heading"><p class="eyebrow">Selected work</p><p class="section-count">01—03</p></div>
    <div class="projects-grid">
      {projects.map((project, index) => <ProjectCard project={project} featured={index === 0} />)}
    </div>
  </section>

  <section id="fun-timez" class="ai-projects wrap section-pad" aria-labelledby="fun-timez-title">
    <div class="section-heading"><h2 id="fun-timez-title" class="eyebrow" data-edit="aiProjects.heading">{copy('aiProjects.heading', 'Fun Timez with AI')}</h2><p class="section-count">01—02</p></div>
    <div class="projects-grid">
      <article class="project-card ai-project-card">
        <a class="ai-project-link" href="https://signal-designer-demo.signal-designer-demo.workers.dev/" target="_blank" rel="noopener noreferrer" aria-label="Launch Job Finder demo in a new tab">
          <div class="project-art ai-project-image">
            <img src="/assets/ai-projects/job-finder-cover.png" alt="Textured cyan, magenta, and yellow ranked job cards layered on a black background" loading="lazy" />
          </div>
          <div class="project-info">
            <span class="project-number">01</span>
            <div>
              <h3 data-edit="aiProjects.jobFinder.title">{copy('aiProjects.jobFinder.title', 'Job Finder')}</h3>
              <p data-edit="aiProjects.jobFinder.description">{copy('aiProjects.jobFinder.description', 'Job searching was scattered across boards, so I built one place to bring it together. Job Finder pulls from public job feeds and employer sites, normalizes the listings, and scores both role fit and posting confidence against preferences I can change. I can triage opportunities and track applications without losing the original listing.')}</p>
              <ul aria-label="Job Finder tech stack"><li>React</li><li>Cloudflare Workers</li><li>Cloudflare D1</li></ul>
              <span class="ai-project-cta">Launch demo <span aria-hidden="true">↗</span></span>
            </div>
          </div>
        </a>
      </article>
      <article class="project-card ai-project-card">
        <a class="ai-project-link" href="https://icons.gaigeredd.com/" target="_blank" rel="noopener noreferrer" aria-label="Launch Icon Finder in a new tab">
          <div class="project-art ai-project-image">
            <img src="/assets/ai-projects/icon-finder-cover.png?v=20260920-1611" alt="Textured cyan, magenta, and yellow icon cards featuring people, a heart, and a smiley face on black" loading="lazy" />
          </div>
          <div class="project-info">
            <span class="project-number">02</span>
            <div>
              <h3 data-edit="aiProjects.iconFinder.title">{copy('aiProjects.iconFinder.title', 'Icon Finder')}</h3>
              <p data-edit="aiProjects.iconFinder.description">{copy('aiProjects.iconFinder.description', 'I kept burning time looking for the right symbol across different libraries. Icon Finder brings five libraries into one searchable catalog, connects everyday concepts to icon names, and ranks the results by relevance. Variants stay grouped, and the detail panel gives me the exact React import or, when available, Unicode value.')}</p>
              <ul aria-label="Icon Finder tech stack"><li>React</li><li>TypeScript</li><li>Vite</li></ul>
              <span class="ai-project-cta">Launch app <span aria-hidden="true">↗</span></span>
            </div>
          </div>
        </a>
      </article>
    </div>
  </section>

  <section id="leadership" class="leadership dark-section">
    <div class="wrap">
      <div class="section-heading"><p class="eyebrow">How I lead</p><p class="section-count">Beyond the pixels</p></div>
      <h2 data-edit="leadership.headline">{copy('leadership.headline', 'Teams will not thrive unless trust and mutual respect underpin the work.')}</h2>
      <div class="principles">
        <article><span class="principle-number">01</span><h3 data-edit="leadership.1.title">{copy('leadership.1.title', 'I’m not always right')}</h3><p data-edit="leadership.1.body">{copy('leadership.1.body', 'Disagreement is an opportunity to listen, test our assumptions against customer evidence, and reach a stronger answer together.')}</p></article>
        <article><span class="principle-number">02</span><h3 data-edit="leadership.2.title">{copy('leadership.2.title', 'Communication')}</h3><p data-edit="leadership.2.body">{copy('leadership.2.body', 'Clear, direct communication keeps cross-functional teams working toward the same goal—and helps me understand what each person needs to grow.')}</p></article>
        <article><span class="principle-number">03</span><h3 data-edit="leadership.3.title">{copy('leadership.3.title', 'I trust my team')}</h3><p data-edit="leadership.3.body">{copy('leadership.3.body', 'I give capable people clear direction, real ownership, and room to do their best work without micromanagement.')}</p></article>
      </div>
    </div>
  </section>

  <section id="about" class="about wrap section-pad">
    <div class="section-heading"><p class="eyebrow">About</p><p class="section-count">The short version</p></div>
    <div class="about-grid">
      <figure class="portrait"><img src="/assets/about/headshot-2026.jpg" alt="Portrait of Gaige Redd" loading="lazy" /></figure>
      <div class="about-copy">
        <h2 data-edit="about.headline">{copy('about.headline', 'Curious by nature. Practical by choice.')}</h2>
        <p class="large-copy" data-edit="about.lede">{copy('about.lede', 'I’m a product designer with more than 13 years of experience, including over four years leading high-performing design teams.')}</p>
        <p data-edit="about.body">{copy('about.body', 'I have a pragmatic approach to design—focus on human-centered design principles and results that drive business outcomes. Outside of work, I’m usually spending time with my family and our dogs. I love the desert, photography, and tinkering with 3D modeling/ printing. More than anything, I like making things. I’ve been fascinated by how things work for as long as I can remember, and few things are more satisfying than repairing something that would otherwise end up in the trash.')}</p>
        <div class="text-links">
          <a href="mailto:gaige@gaigeredd.com">Get in touch</a>
          <a href="/Gaige-Redd-Resume.pdf" target="_blank" rel="noopener">Résumé</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
