---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseStudyGate from '../../components/CaseStudyGate.astro';
import { publishedProjects } from '../../data/projects';
import { copy } from '../../data/copy';

export function getStaticPaths() {
  const standardProjects = publishedProjects
    .filter(project => project.slug !== 'product-page-architecture')
    .map(project => ({ params: { slug: project.slug }, props: { project, archived: false } }));
  const archivedPurple = publishedProjects.find(project => project.slug === 'product-page-architecture');

  return archivedPurple
    ? [...standardProjects, { params: { slug: 'product-page-architecture-archive' }, props: { project: archivedPurple, archived: true } }]
    : standardProjects;
}
const { project, archived = false } = Astro.props;
const usesChapterLayout = Boolean(project.adminChapter || project.employeeChapter);
const galleryPairAfterDecisions = Boolean(project.galleryPairAfterDecisions);
const trailingGalleryStart = usesChapterLayout || galleryPairAfterDecisions ? 1 : 3;
const isRecognitionCase = project.slug === 'recognition-and-rewards';
const trailingGallery = isRecognitionCase ? [] : (project.gallery?.slice(trailingGalleryStart) ?? []);
const currentIndex = publishedProjects.findIndex(item => item.slug === project.slug);
const nextProject = publishedProjects[(currentIndex + 1) % publishedProjects.length];
---
<BaseLayout title={`${project.title}${archived ? ' — Archived' : ''} — Gaige Redd`} description={project.summary} noindex={archived}>
  <CaseStudyGate />
  <article class="case-study">
    <header class="case-hero wrap">
      <a class="back-link" href="/#work" data-edit={`projects.${project.slug}.backLabel`}>{copy(`projects.${project.slug}.backLabel`, '← Selected work')}</a>
      <p class="eyebrow" data-edit={`projects.${project.slug}.caseLabel`}>{copy(`projects.${project.slug}.caseLabel`, `${project.company} / Case study ${project.number}`)}</p>
      <h1 data-edit={`projects.${project.slug}.title`}>{copy(`projects.${project.slug}.title`, project.title)}</h1>
      <p class="case-summary" data-edit={`projects.${project.slug}.headline`}>{copy(`projects.${project.slug}.headline`, project.headline)}</p>
      <div class="case-meta">
        <p><span data-edit={`projects.${project.slug}.meta.organizationLabel`}>{copy(`projects.${project.slug}.meta.organizationLabel`, 'Organization')}</span><span data-edit={`projects.${project.slug}.meta.organization`}>{copy(`projects.${project.slug}.meta.organization`, project.company)}</span></p>
        <p><span data-edit={`projects.${project.slug}.meta.roleLabel`}>{copy(`projects.${project.slug}.meta.roleLabel`, 'Role')}</span><span data-edit={`projects.${project.slug}.meta.role`}>{copy(`projects.${project.slug}.meta.role`, project.caseRole)}</span></p>
        <p><span data-edit={`projects.${project.slug}.meta.focusLabel`}>{copy(`projects.${project.slug}.meta.focusLabel`, 'Focus')}</span><span data-edit={`projects.${project.slug}.meta.focus`}>{copy(`projects.${project.slug}.meta.focus`, project.tags.join(' / '))}</span></p>
      </div>
    </header>

    <figure class="case-cover">
      <img src={project.cover} alt={project.coverAlt} />
    </figure>

    <div class="case-body wrap">
      <section class="case-opening">
        <p class="eyebrow" data-edit={`projects.${project.slug}.labels.challenge`}>{copy(`projects.${project.slug}.labels.challenge`, 'The challenge')}</p>
        <p class="body-lede" data-edit={`projects.${project.slug}.problem`}>{copy(`projects.${project.slug}.problem`, project.problem)}</p>
      </section>

      <section class="case-intro">
        <div><p class="eyebrow" data-edit={`projects.${project.slug}.labels.context`}>{copy(`projects.${project.slug}.labels.context`, 'Context')}</p><h2 data-edit={`projects.${project.slug}.headings.context`}>{copy(`projects.${project.slug}.headings.context`, 'Why this problem mattered.')}</h2></div>
        <p class="body-lede" data-edit={`projects.${project.slug}.context`}>{copy(`projects.${project.slug}.context`, project.context)}</p>
      </section>

      <section class="case-split-section">
        <div><p class="eyebrow" data-edit={`projects.${project.slug}.labels.role`}>{copy(`projects.${project.slug}.labels.role`, 'My role')}</p><h2 data-edit={`projects.${project.slug}.headings.role`}>{copy(`projects.${project.slug}.headings.role`, 'Where I led.')}</h2></div>
        <p class="body-lede" data-edit={`projects.${project.slug}.role`}>{copy(`projects.${project.slug}.role`, project.role)}</p>
      </section>

      {project.adminChapter && (
        <section class="chapter-intro chapter-intro--spaced chapter-intro--accent-label chapter-intro--followed-by-media">
          <p class="eyebrow" data-edit={`projects.${project.slug}.adminChapter.eyebrow`}>{copy(`projects.${project.slug}.adminChapter.eyebrow`, project.adminChapter.eyebrow)}</p>
          <h2 data-edit={`projects.${project.slug}.adminChapter.title`}>{copy(`projects.${project.slug}.adminChapter.title`, project.adminChapter.title)}</h2>
          <p data-edit={`projects.${project.slug}.adminChapter.body`}>{copy(`projects.${project.slug}.adminChapter.body`, project.adminChapter.body)}</p>
        </section>
      )}

      {project.gallery?.[0] && (
        <figure class:list={['case-media', 'case-media-wide', project.gallery[0].treatment === 'paper' && 'case-media--paper', project.gallery[0].treatment === 'clean' && 'case-media--clean']}>
          {project.gallery[0].overlay ? (
            <div class="case-media-composite">
              <img src={project.gallery[0].src} alt={project.gallery[0].alt} loading="eager" />
              <img class="case-media-composite__overlay" src={project.gallery[0].overlay.src} alt={project.gallery[0].overlay.alt} loading="eager" />
            </div>
          ) : <img src={project.gallery[0].src} alt={project.gallery[0].alt} loading="eager" />}
          {project.gallery[0].caption && <figcaption data-edit={`projects.${project.slug}.gallery.0.caption`}>{copy(`projects.${project.slug}.gallery.0.caption`, project.gallery[0].caption)}</figcaption>}
        </figure>
      )}

      <section>
        <p class="eyebrow" data-edit={`projects.${project.slug}.labels.approach`}>{copy(`projects.${project.slug}.labels.approach`, 'The approach')}</p>
        <h2 data-edit={`projects.${project.slug}.headings.approach`}>{copy(`projects.${project.slug}.headings.approach`, 'Turn evidence into direction.')}</h2>
        <ol class="case-list">
          {project.approach?.map((item, i) => <li><span data-edit={`projects.${project.slug}.approach.${i}.number`}>{copy(`projects.${project.slug}.approach.${i}.number`, `0${i + 1}`)}</span><div><h3 data-edit={`projects.${project.slug}.approach.${i}.title`}>{copy(`projects.${project.slug}.approach.${i}.title`, item.title)}</h3><p data-edit={`projects.${project.slug}.approach.${i}.body`}>{copy(`projects.${project.slug}.approach.${i}.body`, item.body)}</p></div></li>)}
        </ol>
      </section>

      {!usesChapterLayout && !galleryPairAfterDecisions && project.gallery && project.gallery.length > 2 && (
        <div class="media-pair">
          {project.gallery.slice(1, 3).map((item, i) => <figure class:list={['case-media', item.fit === 'landscape-crop' && 'case-media--landscape-crop', item.treatment === 'paper' && 'case-media--paper', item.treatment === 'clean' && 'case-media--clean']}>{item.overlay ? <div class="case-media-composite"><img src={item.src} alt={item.alt} loading="lazy" /><img class="case-media-composite__overlay" src={item.overlay.src} alt={item.overlay.alt} loading="lazy" /></div> : <img src={item.src} alt={item.alt} loading="lazy" />}{item.caption && <figcaption data-edit={`projects.${project.slug}.gallery.${i + 1}.caption`}>{copy(`projects.${project.slug}.gallery.${i + 1}.caption`, item.caption)}</figcaption>}</figure>)}
        </div>
      )}

      {!usesChapterLayout && <section class:list={['decision-section', galleryPairAfterDecisions && 'decision-section--media-follow']}>
        {project.decisionIntro ? (
          <div class="case-split-section">
            <div>
              <p class="eyebrow" data-edit={`projects.${project.slug}.labels.decisions`}>{copy(`projects.${project.slug}.labels.decisions`, 'Key decisions')}</p>
              <h2 data-edit={`projects.${project.slug}.decisionIntro.headline`}>{copy(`projects.${project.slug}.decisionIntro.headline`, project.decisionIntro.headline)}</h2>
            </div>
            <p class="body-lede" data-edit={`projects.${project.slug}.decisionIntro.body`}>{copy(`projects.${project.slug}.decisionIntro.body`, project.decisionIntro.body)}</p>
          </div>
        ) : (
          <>
            <p class="eyebrow" data-edit={`projects.${project.slug}.labels.decisions`}>{copy(`projects.${project.slug}.labels.decisions`, 'Key decisions')}</p>
            <h2 data-edit={`projects.${project.slug}.headings.decisions`}>{copy(`projects.${project.slug}.headings.decisions`, 'The choices that shaped the work.')}</h2>
          </>
        )}
        <div class="decision-grid">
          {project.decisions?.map((item, i) => <article><span data-edit={`projects.${project.slug}.decisions.${i}.number`}>{copy(`projects.${project.slug}.decisions.${i}.number`, `0${i + 1}`)}</span><h3 data-edit={`projects.${project.slug}.decisions.${i}.title`}>{copy(`projects.${project.slug}.decisions.${i}.title`, item.title)}</h3><p data-edit={`projects.${project.slug}.decisions.${i}.body`}>{copy(`projects.${project.slug}.decisions.${i}.body`, item.body)}</p></article>)}
        </div>
      </section>}

      {project.employeeChapter && (
        <section class="chapter-intro chapter-intro--spaced chapter-intro--magenta chapter-intro--accent-label">
          <p class="eyebrow" data-edit={`projects.${project.slug}.employeeChapter.eyebrow`}>{copy(`projects.${project.slug}.employeeChapter.eyebrow`, project.employeeChapter.eyebrow)}</p>
          <h2 data-edit={`projects.${project.slug}.employeeChapter.title`}>{copy(`projects.${project.slug}.employeeChapter.title`, project.employeeChapter.title)}</h2>
          <p data-edit={`projects.${project.slug}.employeeChapter.body`}>{copy(`projects.${project.slug}.employeeChapter.body`, project.employeeChapter.body)}</p>
        </section>
      )}

      {project.highlight && (
        <section class="case-split-section">
          <div>
            <p class="eyebrow" data-edit={`projects.${project.slug}.highlight.eyebrow`}>{copy(`projects.${project.slug}.highlight.eyebrow`, project.highlight.eyebrow)}</p>
            <h2 data-edit={`projects.${project.slug}.highlight.title`}>{copy(`projects.${project.slug}.highlight.title`, project.highlight.title)}</h2>
          </div>
          <p class="body-lede" data-edit={`projects.${project.slug}.highlight.body`}>{copy(`projects.${project.slug}.highlight.body`, project.highlight.body)}</p>
        </section>
      )}

      {isRecognitionCase && (
        <section class="bamboohr-figma-section" aria-label="Recognition feed and suggestion workflow">
          <div class="bamboohr-figma-canvas">
            <img src="/assets/work/bamboohr/recognition-composite.png" alt="BambooHR Recognition feed, suggestions, and edit dialog" loading="lazy" />
            <p class="bamboohr-figma-caption" data-edit={`projects.${project.slug}.employeeCaption`}>{copy(`projects.${project.slug}.employeeCaption`, 'The agent suggested a person, reason, and editable message. Employees kept control of values, points, privacy, and sending. Suggestions launched across Slack, email, and the platform; recognition could also be sent directly from Slack.')}</p>
          </div>
        </section>
      )}

      {project.progression && (
        <section class="case-progression" aria-label={project.progression.title}>
          <p class="eyebrow" data-edit={`projects.${project.slug}.progression.eyebrow`}>{copy(`projects.${project.slug}.progression.eyebrow`, project.progression.eyebrow)}</p>
          <h2 data-edit={`projects.${project.slug}.progression.title`}>{copy(`projects.${project.slug}.progression.title`, project.progression.title)}</h2>
          <ol class="case-progression-stages">
            {project.progression.stages.map((stage, i) => (
              <li>
                <p class="case-progression-period" data-edit={`projects.${project.slug}.progression.stages.${i}.period`}>{copy(`projects.${project.slug}.progression.stages.${i}.period`, stage.period)}</p>
                <h3 data-edit={`projects.${project.slug}.progression.stages.${i}.phase`}>{copy(`projects.${project.slug}.progression.stages.${i}.phase`, stage.phase)}</h3>
                <p class="case-progression-detail" data-edit={`projects.${project.slug}.progression.stages.${i}.detail`}>{copy(`projects.${project.slug}.progression.stages.${i}.detail`, stage.detail)}</p>
                <p class="case-progression-audience" data-edit={`projects.${project.slug}.progression.stages.${i}.audience`}>{copy(`projects.${project.slug}.progression.stages.${i}.audience`, stage.audience)}</p>
                <p class="case-progression-result" data-edit={`projects.${project.slug}.progression.stages.${i}.result`}>{copy(`projects.${project.slug}.progression.stages.${i}.result`, stage.result)}</p>
              </li>
            ))}
          </ol>
          <p class="case-progression-note" data-edit={`projects.${project.slug}.progression.note`}>{copy(`projects.${project.slug}.progression.note`, project.progression.note)}</p>
        </section>
      )}

      {trailingGallery.length > 0 && (
        <div class:list={['case-gallery', trailingGallery.length === 1 && 'case-gallery--single']}>
          {trailingGallery.map((item, i) => <figure class:list={['case-media', (trailingGallery.length === 1 || (i === 0 && !galleryPairAfterDecisions)) && 'case-media-wide', item.fit === 'landscape-crop' && 'case-media--landscape-crop', item.treatment === 'paper' && 'case-media--paper', item.treatment === 'clean' && 'case-media--clean']}>{item.overlay ? <div class="case-media-composite"><img src={item.src} alt={item.alt} loading="lazy" /><img class="case-media-composite__overlay" src={item.overlay.src} alt={item.overlay.alt} loading="lazy" /></div> : <img src={item.src} alt={item.alt} loading="lazy" />}{item.caption && <figcaption data-edit={`projects.${project.slug}.gallery.${i + trailingGalleryStart}.caption`}>{copy(`projects.${project.slug}.gallery.${i + trailingGalleryStart}.caption`, item.caption)}</figcaption>}</figure>)}
        </div>
      )}

      {project.workflowShowcases && (
        <section class="case-workflows">
          {project.workflowShowcases.map((item, i) => (
            <article class="case-workflow">
              <div class="case-split-section">
                <div>
                  <p class="eyebrow" data-edit={`projects.${project.slug}.workflowShowcases.${i}.eyebrow`}>{copy(`projects.${project.slug}.workflowShowcases.${i}.eyebrow`, item.eyebrow)}</p>
                  <h2 data-edit={`projects.${project.slug}.workflowShowcases.${i}.title`}>{copy(`projects.${project.slug}.workflowShowcases.${i}.title`, item.title)}</h2>
                </div>
                <p data-edit={`projects.${project.slug}.workflowShowcases.${i}.body`}>{copy(`projects.${project.slug}.workflowShowcases.${i}.body`, item.body)}</p>
              </div>
              <figure
                class:list={['case-media', 'case-workflow-media', item.cropHeight && 'case-workflow-media--crop-top']}
                style={item.cropHeight ? `--workflow-crop-height:${item.cropHeight}px` : undefined}
              >
                <img src={item.media} alt={item.alt} loading="lazy" />
              </figure>
            </article>
          ))}
        </section>
      )}

      {!usesChapterLayout && <section class="outcome">
        <p class="eyebrow" data-edit={`projects.${project.slug}.labels.outcome`}>{copy(`projects.${project.slug}.labels.outcome`, 'Outcome')}</p>
        <h2 data-edit={`projects.${project.slug}.headings.outcome`}>{copy(`projects.${project.slug}.headings.outcome`, 'What changed.')}</h2>
        <div class="outcome-stats">
          {project.outcomes?.map((item, i) => <p><strong data-edit={`projects.${project.slug}.outcomes.${i}.value`}>{copy(`projects.${project.slug}.outcomes.${i}.value`, item.value)}</strong><span data-edit={`projects.${project.slug}.outcomes.${i}.label`}>{copy(`projects.${project.slug}.outcomes.${i}.label`, item.label)}</span></p>)}
        </div>
        <p class="body-lede" data-edit={`projects.${project.slug}.outcome`}>{copy(`projects.${project.slug}.outcome`, project.outcomeCopy)}</p>
      </section>}

      <nav class="case-next" aria-label="Case study navigation">
        <a href="/#work" data-edit={`projects.${project.slug}.navigation.allWork`}>{copy(`projects.${project.slug}.navigation.allWork`, '← All selected work')}</a>
        <a href={`/work/${nextProject.slug}/`} data-edit={`projects.${project.slug}.navigation.next`}>{copy(`projects.${project.slug}.navigation.next`, `Next: ${nextProject.company} ↗`)}</a>
      </nav>
    </div>
  </article>
</BaseLayout>
