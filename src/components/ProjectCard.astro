---
import type { Project } from '../data/projects';
import { copy } from '../data/copy';
const { project, featured = false, coverStyle = 'clean' } = Astro.props as { project: Project; featured?: boolean; coverStyle?: 'clean' | 'editorial' };
---
<article class:list={['project-card', featured && 'featured']}>
  <a class:list={[project.status === 'draft' && 'project-draft']} href={project.status === 'draft' ? undefined : `/work/${project.slug}/`} aria-label={project.status === 'draft' ? `${project.title} case study coming soon` : `View case study: ${project.title}`}>
    <div class:list={['project-art', !project.cover && project.slug !== 'recognition-and-rewards' && 'project-art-empty', ['ai-order-cloud','recognition-and-rewards','product-page-architecture'].includes(project.slug) && 'project-art-editorial']}>
      {project.cover ? (
        <img src={project.cover} alt={project.coverAlt || ''} loading={featured ? 'eager' : 'lazy'} />
      ) : coverStyle === 'clean' && ['ai-order-cloud','recognition-and-rewards','product-page-architecture'].includes(project.slug) ? (
        <div class:list={['clean-cover', `clean-cover-${project.slug}`]} role="img" aria-label={`${project.company} ${project.title} project cover`}>
          <div class="clean-cover-top"><span>{project.company}</span><span>{project.number}</span></div>
          <div class="clean-cover-focus">
            {project.slug === 'recognition-and-rewards' ? <><strong>0→1</strong><span>Admin clarity.<br />Employee speed.</span></> : project.slug === 'ai-order-cloud' ? <><strong>49%</strong><span>Faster data analysis<br />in beta</span></> : <><strong>61%</strong><span>Increase in<br />bedding upgrades</span></>}
          </div>
        </div>
      ) : project.slug === 'recognition-and-rewards' ? (
        <div class="story-cover bamboo-story-cover" role="img" aria-label="Concept cover for BambooHR Recognition and Rewards">
          <div class="story-copy">
            <p class="story-kicker">BAMBOOHR / 0→1 PRODUCT</p>
            <div>
              <h4>Recognition<br />people can feel.</h4>
              <p class="story-premise">Bringing meaningful recognition and rewards into the flow of employee experience.</p>
            </div>
            <p class="story-status"><span></span>CASE STUDY IN DEVELOPMENT</p>
          </div>
          <div class="bamboo-story-visual">
            <p class="concept-label">CONCEPT MOCKUP</p>
            <article class="recognition-card">
              <div class="recognition-people"><span>MC</span><span>LR</span></div>
              <p><strong>Maya recognized Luis</strong><br />“You made a complicated launch feel simple.”</p>
              <div class="recognition-reward"><span>MAKING THINGS BETTER</span><strong>+250 points</strong></div>
            </article>
            <div class="reward-card"><span>Reward balance</span><strong>1,840</strong><button type="button" tabindex="-1">Explore rewards ↗</button></div>
          </div>
        </div>
      ) : project.slug === 'ai-order-cloud' ? (
        <div class="story-cover fabric-story-cover" role="img" aria-label="Fabric AI Order Cloud project: from bolt-on chatbot to embedded workflows">
          <div class="story-copy">
            <p class="story-kicker">FABRIC / AI STRATEGY</p>
            <div>
              <h4>AI in the<br />flow of work.</h4>
              <p class="story-premise">From a bolt-on chatbot to embedded merchandising and fulfillment workflows.</p>
            </div>
            <p class="story-outcome"><strong>49%</strong><span>faster data analysis in beta</span></p>
          </div>
          <div class="ai-sequence" aria-label="Before: AI separated into a generic chatbot. After: AI embedded in merchandising, fulfillment, and inventory workflows.">
            <p class="sequence-label">BEFORE / A SEPARATE DESTINATION</p>
            <div class="chat-before">
              <span>fabAI</span>
              <p>Ask me anything…</p>
              <small>Generic chat, disconnected from the work</small>
            </div>
            <div class="sequence-arrow" aria-hidden="true">↓</div>
            <p class="sequence-label">AFTER / AI IN THE FLOW OF WORK</p>
            <div class="workflow-after">
              <article><b>MERCHANDISING</b><strong>Improve product content</strong><span>AI suggestion ↗</span></article>
              <article><b>FULFILLMENT</b><strong>Reduce split shipments</strong><span>AI action ↗</span></article>
              <article><b>INVENTORY</b><strong>Surface performance</strong><span>AI insight ↗</span></article>
            </div>
          </div>
        </div>
      ) : project.slug === 'product-page-architecture' ? (
        <div class="story-cover purple-story-cover" role="img" aria-label="Purple product page architecture project: fewer decisions and better outcomes">
          <div class="story-copy">
            <p class="story-kicker">PURPLE / COMMERCE UX</p>
            <div>
              <h4>Fewer decisions.<br />Better outcomes.</h4>
              <p class="story-premise">Resequencing a high-consideration purchase to reduce cognitive load without sacrificing cross-sell opportunity.</p>
            </div>
            <p class="story-outcome purple-story-outcome"><strong>61%</strong><span>increase in bedding upgrades</span></p>
          </div>
          <div class="decision-sequence" aria-label="Before: mattress and all add-ons presented together. After: mattress choice and add-ons separated into two focused steps.">
            <p class="sequence-label">BEFORE / ONE OVERLOADED MOMENT</p>
            <div class="before-card">
              <strong>Choose everything</strong>
              <span>Mattress</span><span>Bed frame</span><span>Sheets</span><span>Pillows</span><span>Protector</span>
            </div>
            <div class="sequence-arrow" aria-hidden="true">↓</div>
            <p class="sequence-label">AFTER / TWO FOCUSED MOMENTS</p>
            <div class="after-cards">
              <article><b>01</b><strong>Choose your mattress</strong><span>Make the primary decision</span></article>
              <article><b>02</b><strong>Add the extras</strong><span>Consider relevant upgrades</span></article>
            </div>
          </div>
        </div>
      ) : <div class="draft-art"><span>BAMBOOHR</span><strong>R + R</strong><small>CASE STUDY IN DEVELOPMENT</small></div>}
    </div>
    <div class="project-info">
      <span class="project-number">{project.number}</span>
      <div>
        <h3 data-edit={`projects.${project.slug}.title`}>{copy(`projects.${project.slug}.title`, project.title)}</h3>
        <p data-edit={`projects.${project.slug}.summary`}>{copy(`projects.${project.slug}.summary`, project.summary)}</p>
        <ul aria-label="Project disciplines">{project.tags.map(tag => <li>{tag}</li>)}</ul>
      </div>
    </div>
  </a>
</article>
