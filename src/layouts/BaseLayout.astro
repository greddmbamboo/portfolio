---
import '../styles/global.css';
import InlineEditor from '../components/InlineEditor.astro';
interface Props { title?: string; description?: string; }
const {
  title = 'Gaige Redd — Product Design Leader',
  description = 'Gaige Redd is a product design leader shaping useful products, strong teams, and durable design organizations.'
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2f1ea" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {import.meta.env.DEV && <script src="https://mcp.figma.com/mcp/html-to-design/capture.js" async></script>}
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="Gaige Redd, home">
        <svg viewBox="0 0 27.115902439024392 40" aria-hidden="true">
          <path d="M27.1159 5.5303l-.085.0006c-3.3425.0423-6.2258 2.5818-6.6045 5.8387l-.05.3889c-.1966 1.3269-.6475 2.5708-1.3019 3.6807 4.1463 2.1788 6.9743 6.5272 6.9743 11.5364C26.0488 34.1688 20.2176 40 13.0244 40S0 34.1688 0 26.9756h6.304c-.0005.0343-.0008.0685-.0008.1028 0 3.7688 3.0552 6.824 6.824 6.824s6.824-3.0552 6.824-6.824c0-3.7687-3.0421-6.6942-6.8109-6.6942-.6946 0-1.301.0341-1.9384.0592-.3155.0293-.635.0444-.958.0444C4.5864 20.4878 0 15.9015 0 10.2439S4.5864 0 10.2439 0c3.2436 0 6.1349 1.5076 8.0119 3.8602C20.4647 1.4855 23.6168 0 27.1159 0ZM10.2439 5.561a4.6829 4.6829 0 1 0 0 9.3658 4.6829 4.6829 0 0 0 0-9.3658Z" />
        </svg>
      </a>
      <nav aria-label="Primary navigation">
        <a href="/#work">Work</a>
        <a href="/#leadership">Leadership</a>
        <a href="/#about">About</a>
        <a href="mailto:gaige@gaigeredd.com">Contact</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer wrap">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <a class="footer-cta" href="mailto:gaige@gaigeredd.com">gaige@gaigeredd.com <span aria-hidden="true">↗</span></a>
      </div>
      <div class="footer-meta">
        <p>Product design leadership<br />from Denver, Colorado.</p>
        <p>© {new Date().getFullYear()} Gaige Redd<br />Built with care and Astro.</p>
      </div>
    </footer>
    {import.meta.env.DEV && <InlineEditor />}
  </body>
</html>
