---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const {
  title = 'Gaige Redd — Product Design Leader',
  description = 'Gaige Redd is a product design leader shaping useful products, strong teams, and durable design organizations.'
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f2f1ea" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="Gaige Redd, home">GR<span>.</span></a>
      <nav aria-label="Primary navigation">
        <a href="/#work">Work</a>
        <a href="/#leadership">Leadership</a>
        <a href="/#about">About</a>
        <a href="mailto:hello@gaigeredd.com">Contact</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer wrap">
      <div>
        <p class="eyebrow">Start a conversation</p>
        <a class="footer-cta" href="mailto:hello@gaigeredd.com">hello@gaigeredd.com <span aria-hidden="true">↗</span></a>
      </div>
      <div class="footer-meta">
        <p>Product design leadership<br />from Denver, Colorado.</p>
        <p>© {new Date().getFullYear()} Gaige Redd<br />Built with care and Astro.</p>
      </div>
    </footer>
  </body>
</html>
